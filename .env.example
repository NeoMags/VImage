# Desktop-only build: no cloud services, no API keys required.
# Optional developer overrides for the sidecar:
IV_LIBRARY_DIR=            # default %LOCALAPPDATA%\ImageVault
IV_MODELS_DIR=             # default %LOCALAPPDATA%\ImageVault\models
IV_OLLAMA_URL=             # optional local Ollama, e.g. http://127.0.0.1:11434 (Phase D5)
