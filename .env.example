# Copy to .env (never commit). Values come from the Supabase dashboard / provider consoles.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-side only: api + worker, never shipped to clients
SUPABASE_JWT_ISSUER=
DATABASE_URL=                   # direct Postgres connection for worker
BROKER_URL=redis://localhost:6379/0   # Valkey (BSD) or Redis; see docs/09
STORAGE_BACKEND=supabase        # supabase | r2 | s3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CLOUD_AI_PROVIDER=none          # none | ollama | openai_compatible
CLOUD_AI_BASE_URL=
CLOUD_AI_API_KEY=
