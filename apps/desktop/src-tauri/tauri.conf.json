{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImageVault",
  "version": "0.0.1",
  "identifier": "com.neomags.imagevault",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "ImageVault", "width": 900, "height": 700 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../services/sidecar/dist/ivsidecar/": "sidecar/"
    }
  }
}
